  "SOURCE_L0081": "class NoRedirect(urllib.request.HTTPRedirectHandler):",
  "SOURCE_L0082": "    def redirect_request(self, *args, **kwargs):",
  "SOURCE_L0083": "        raise ValueError('D04_SIGNAL_REDIRECT')",

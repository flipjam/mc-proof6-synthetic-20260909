  "SOURCE_L0420": "def _serve(setup):",
  "SOURCE_L0421": "    # This entry is started in a separate credential-scoped workflow step BEFORE",
  "SOURCE_L0422": "    # the App-token action. It never imports writer/journal/admission or reads",
  "SOURCE_L0423": "    # the writer's environment or credential stores. Its sole ancestor inspection",
  "SOURCE_L0424": "    # is the fixed provider-masked Worker startup diagnostic for permissions.",
  "SOURCE_L0425": "    b = binding()",
  "SOURCE_L0426": "    custody(True, setup)",
  "SOURCE_L0427": "    require(not any(k.startswith('PROOF6_APP') or k in ('GH_TOKEN', 'PROOF6_D03_JOB_TOKEN',",
  "SOURCE_L0428": "                       'PROOF6_FROZEN_MANIFEST') for k in os.environ))",
  "SOURCE_L0429": "    token = os.environ.pop(TOKEN_SLOT)",
  "SOURCE_L0430": "    require(token and token not in '\\0'.join(sys.argv))",
  "SOURCE_L0431": "    permissions = _permission_evidence(_worker_log(), b, setup) if setup else _permission_evidence(_worker_log(), b)",
  "SOURCE_L0432": "    root = directory(b)",
  "SOURCE_L0433": "    require(root.is_dir() and root.stat().st_uid == 0 and root.stat().st_mode & 0o077 == 0)",
  "SOURCE_L0434": "    # Exact startup identity/effective permissions are read before the workflow",
  "SOURCE_L0435": "    # proceeds to create the App installation token. The provider masks secrets",
  "SOURCE_L0436": "    # before writing its startup diagnostic; no raw diagnostic is retained.",
  "SOURCE_L0437": "    # Setup has no provider request, event loop or App/authority import.",
  "SOURCE_L0438": "    # Discard its token immediately after auditing the exact effective grant.",
  "SOURCE_L0439": "    preflight = None if setup else status_request(token, b)",
  "SOURCE_L0440": "    if setup:",
  "SOURCE_L0441": "        token = None",
  "SOURCE_L0442": "    def deadline(*_):",
  "SOURCE_L0443": "        raise TimeoutError('D04_SIGNAL_DEADLINE')",
  "SOURCE_L0444": "    signal.signal(signal.SIGALRM, deadline)",
  "SOURCE_L0445": "    signal.signal(signal.SIGTERM, deadline)",
  "SOURCE_L0446": "    expires = time.monotonic() + 105",
  "SOURCE_L0447": "    signal.alarm(105)",
  "SOURCE_L0448": "    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as server:",
  "SOURCE_L0449": "        server.bind(str(root / 'events.sock'))",
  "SOURCE_L0450": "        server.listen(1); server.settimeout(90)",
  "SOURCE_L0451": "        marker = {'schema': SCHEMA, 'pid': os.getpid(), 'binding': b,",
  "SOURCE_L0452": "                  'permissions': PERMISSIONS, 'provider_preflight': preflight,",
  "SOURCE_L0453": "                  'deadline': expires}",
  "SOURCE_L0454": "        (root / 'started.json').write_bytes(canonical(marker))",
  "SOURCE_L0455": "        receipt('HELPER_STARTED', **marker, permission_evidence=permissions, acceptance_credit=False)",
  "SOURCE_L0456": "        conn, _ = server.accept()",
  "SOURCE_L0457": "        with conn:",
  "SOURCE_L0458": "            pid, uid, _ = peer(conn)",
  "SOURCE_L0459": "            require(uid == 0 and pid != os.getpid())",
  "SOURCE_L0460": "            expected = [b'/usr/bin/python3', b'-B', b'proofs/proof6/actions_runtime.py']",
  "SOURCE_L0461": "            if setup:",
  "SOURCE_L0462": "                expected = [b'/usr/bin/python3', b'-I', b'-B', b'proofs/proof6/d04_signal.py', b'qualify-setup']",
  "SOURCE_L0463": "            require(Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\\0')[:-1] == expected)",
  "SOURCE_L0464": "            if setup:",
  "SOURCE_L0465": "                conn.settimeout(8)",
  "SOURCE_L0466": "                packet(conn, dict(marker, phase='SETUP_QUALIFIED'))",
  "SOURCE_L0467": "                require(canonical(receive(conn)) == canonical({'schema': SCHEMA, 'binding': b, 'pid': pid, 'phase': 'SETUP_FINISH'}))",
  "SOURCE_L0468": "                packet(conn, {'schema': SCHEMA, 'binding': b, 'phase': 'SETUP_FINISHED'})",
  "SOURCE_L0469": "                peer_shutdown(conn)",
  "SOURCE_L0470": "                result = {'schema': SCHEMA, 'binding': b, 'phase': 'SETUP_SIGNAL_QUALIFIED',",
  "SOURCE_L0471": "                    'permissions': PERMISSIONS, 'runner_version': RUNNER_VERSION, 'runner_commit': RUNNER_COMMIT,",
  "SOURCE_L0472": "                    'helper_pid': os.getpid(), 'producer_pid': pid, 'custody': True,",
  "SOURCE_L0473": "                    'status_posts': 0, 'acceptance_credit': False}",
  "SOURCE_L0474": "                (root / 'setup-result.json').write_bytes(canonical(result))",
  "SOURCE_L0475": "                signal.alarm(0)",
  "SOURCE_L0476": "                receipt('SETUP_HELPER_COMPLETED', **result)",
  "SOURCE_L0477": "                return",
  "SOURCE_L0478": "            packet(conn, dict(marker, phase='QUALIFIED'))",
  "SOURCE_L0479": "            conn.settimeout(45)",
  "SOURCE_L0480": "            ready = None",
  "SOURCE_L0481": "            for phase in ('READY', 'END'):",
  "SOURCE_L0482": "                event = receive(conn)",
  "SOURCE_L0483": "                event_valid(event, b, pid, phase, ready)",
  "SOURCE_L0484": "                require(os.readlink(f'/proc/{pid}/ns/net') == event['observation']['netns_after'])",
  "SOURCE_L0485": "                result = status_request(token, b, event)",
  "SOURCE_L0486": "                receipt('STATUS_POST', binding=b, event=event, provider=result, acceptance_credit=False)",
  "SOURCE_L0487": "                packet(conn, {'phase': phase, 'binding': b, 'posted': True})",
  "SOURCE_L0488": "                if phase == 'READY':",
  "SOURCE_L0489": "                    ready = event",
  "SOURCE_L0490": "            peer_shutdown(conn)",
  "SOURCE_L0491": "    signal.alarm(0)",
  "SOURCE_L0492": "    receipt('HELPER_COMPLETED', binding=b, acceptance_credit=False)",

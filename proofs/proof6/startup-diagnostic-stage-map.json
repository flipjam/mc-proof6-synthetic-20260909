  "SOURCE_L0018": "import d04_capability as capability",
  "SOURCE_L0019": "",
  "SOURCE_L0020": "REPO = 'flipjam/mc-proof6-synthetic-20260909'",
  "SOURCE_L0021": "RUNTIME = 'refs/heads/codex/proof6-r3h-s1-startup-diagnostic-20260912-01'",
  "SOURCE_L0022": "SCHEMA = 'PROOF6_R3H_D04_SIGNAL_V1'",

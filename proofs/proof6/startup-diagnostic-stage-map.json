  "SOURCE_L0086": "def status_request(token, b, event=None):",
  "SOURCE_L0087": "    # The only two API shapes are fixed to the frozen runtime commit. No input",
  "SOURCE_L0088": "    # selects endpoint, method, text, context, repository, ref or force value.",
  "SOURCE_L0089": "    payload = None if event is None else {",
  "SOURCE_L0090": "        'context': b['context'], 'state': 'pending' if event['phase'] == 'READY' else 'success',",
  "SOURCE_L0091": "        'description': f\"{event['phase']} r={b['run_id']} a=1 sha={b['runtime_sha']} p={event['pid']}\",",
  "SOURCE_L0092": "        'target_url': f\"https://github.com/{REPO}/actions/runs/{b['run_id']}\"}",
  "SOURCE_L0093": "    path = (f\"commits/{b['target_sha']}/statuses?per_page=100\" if payload is None",
  "SOURCE_L0094": "            else f\"statuses/{b['target_sha']}\")",
  "SOURCE_L0095": "    req = urllib.request.Request('https://api.github.com/repos/' + REPO + '/' + path,",
  "SOURCE_L0096": "        data=None if payload is None else canonical(payload), headers={",
  "SOURCE_L0097": "            'Authorization': 'Bearer ' + token, 'Accept': 'application/vnd.github+json',",
  "SOURCE_L0098": "            'Content-Type': 'application/json', 'X-GitHub-Api-Version': '2022-11-28',",
  "SOURCE_L0099": "            'User-Agent': 'proof6-fixed-d04-signal'})",
  "SOURCE_L0100": "    started = utc()",
  "SOURCE_L0101": "    with urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect()).open(req, timeout=5) as response:",
  "SOURCE_L0102": "        require(response.status == (200 if payload is None else 201))",
  "SOURCE_L0103": "        raw = response.read(1_000_001); require(len(raw) <= 1_000_000)",
  "SOURCE_L0104": "        value = json.loads(raw, object_pairs_hook=unique)",
  "SOURCE_L0105": "        if payload is None:",
  "SOURCE_L0106": "            # Fail closed on pagination: no uninspected stale context can hide.",
  "SOURCE_L0107": "            require(isinstance(value, list) and 'next' not in response.headers.get('Link', ''))",
  "SOURCE_L0108": "            require(all(item['context'] != b['context'] for item in value))",
  "SOURCE_L0109": "        else:",
  "SOURCE_L0110": "            require(all(value[k] == v for k, v in payload.items())",
  "SOURCE_L0111": "                    and value['creator']['login'] == 'github-actions[bot]' and value['creator']['id'] == 41898282)",
  "SOURCE_L0112": "        result = {'started_at': started, 'completed_at': utc(), 'http_status': response.status,",
  "SOURCE_L0113": "                  'date': response.headers.get('Date'),",
  "SOURCE_L0114": "                  'request_id': response.headers.get('X-GitHub-Request-Id'), 'payload': payload}",
  "SOURCE_L0115": "        if payload is not None:",
  "SOURCE_L0116": "            require(type(value['id']) is int and value['id'] > 0)",
  "SOURCE_L0117": "            result.update(status_id=value['id'], created_at=value['created_at'],",
  "SOURCE_L0118": "                          creator={'login': 'github-actions[bot]', 'id': 41898282})",
  "SOURCE_L0119": "        return result",
  "SOURCE_L0120": "",
  "SOURCE_L0121": "",
  "SOURCE_L0122": "def peer(sock):",
  "SOURCE_L0123": "    return struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))",
  "SOURCE_L0124": "",
  "SOURCE_L0125": "",
  "SOURCE_L0126": "def packet(sock, value):",
  "SOURCE_L0127": "    raw = canonical(value); require(len(raw) <= MAX_PACKET)",
  "SOURCE_L0128": "    require(sock.send(raw) == len(raw))",
  "SOURCE_L0129": "",
  "SOURCE_L0130": "",
  "SOURCE_L0131": "def receive_boundary(sock):",
  "SOURCE_L0132": "    raw, ancillary, flags, _ = sock.recvmsg(MAX_PACKET + 1, CONTROL_BYTES)",
  "SOURCE_L0133": "    # recvmsg installs SCM_RIGHTS descriptors even when validation will fail.",
  "SOURCE_L0134": "    # Close every complete received descriptor BEFORE any parsing/flag rejection.",
  "SOURCE_L0135": "    for level, kind, data in ancillary:",
  "SOURCE_L0136": "        if level == 1 and kind == 1:  # Fixed Linux SOL_SOCKET / SCM_RIGHTS.",
  "SOURCE_L0137": "            fds = array.array('i')",
  "SOURCE_L0138": "            fds.frombytes(data[:len(data) - len(data) % fds.itemsize])",
  "SOURCE_L0139": "            for fd in fds:",
  "SOURCE_L0140": "                try:",
  "SOURCE_L0141": "                    os.close(fd)",
  "SOURCE_L0142": "                except OSError:",
  "SOURCE_L0143": "                    pass  # Still reject the entire control-bearing packet.",
  "SOURCE_L0144": "    require(not ancillary and flags & ~getattr(socket, 'MSG_EOR', 0) == 0)",
  "SOURCE_L0145": "    return raw",
  "SOURCE_L0146": "",
  "SOURCE_L0147": "",
  "SOURCE_L0148": "def receive(sock):",
  "SOURCE_L0149": "    raw = receive_boundary(sock)",
  "SOURCE_L0150": "    require(raw)",
  "SOURCE_L0151": "    value = decode(raw)",
  "SOURCE_L0152": "    require(raw == canonical(value))",
  "SOURCE_L0153": "    return value",
  "SOURCE_L0154": "",
  "SOURCE_L0155": "",
  "SOURCE_L0156": "def peer_shutdown(sock):",
  "SOURCE_L0157": "    # Linux supplies SCM_CREDENTIALS for EVERY queued packet when SO_PASSCRED",
  "SOURCE_L0158": "    # is enabled, including a zero-length packet queued before this call.",
  "SOURCE_L0159": "    # Transport EOF has no packet/control message. Thus receive_boundary",
  "SOURCE_L0160": "    # rejects all trailing records, even empty records followed by close.",
  "SOURCE_L0161": "    # This option is enabled only after the fixed protocol has completed.",
  "SOURCE_L0162": "    sock.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)",
  "SOURCE_L0163": "    sock.settimeout(5)",
  "SOURCE_L0164": "    require(receive_boundary(sock) == b'')",
  "SOURCE_L0165": "    poller = select.poll()",
  "SOURCE_L0166": "    poller.register(sock, select.POLLRDHUP | select.POLLHUP | select.POLLERR)",
  "SOURCE_L0167": "    events = poller.poll(0)",
  "SOURCE_L0168": "    require(len(events) == 1 and events[0][1] & select.POLLRDHUP",
  "SOURCE_L0169": "            and not events[0][1] & (select.POLLERR | select.POLLNVAL))",
  "SOURCE_L0170": "",
  "SOURCE_L0171": "",
  "SOURCE_L0172": "PUBLIC_ENV = {'GITHUB_REPOSITORY', 'GITHUB_REPOSITORY_ID', 'GITHUB_REF', 'GITHUB_WORKFLOW_REF',",
  "SOURCE_L0173": "    'GITHUB_SHA', 'GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_EVENT_NAME'}",
  "SOURCE_L0174": "SYSTEM_ENV = {'PATH', 'LANG', 'HOME', 'USER', 'LOGNAME', 'SHELL', 'TERM', 'MAIL',",
  "SOURCE_L0175": "    'SUDO_COMMAND', 'SUDO_USER', 'SUDO_UID', 'SUDO_GID', 'PWD', 'SHLVL', '_'}",
  "SOURCE_L0176": "WRITER_ENV = {'GITHUB_JOB', 'GITHUB_RUN_NUMBER', 'GITHUB_ACTOR', 'GITHUB_ACTOR_ID',",
  "SOURCE_L0177": "    'GITHUB_TRIGGERING_ACTOR', 'GITHUB_EVENT_PATH', 'RUNNER_ENVIRONMENT', 'RUNNER_OS',",
  "SOURCE_L0178": "    'RUNNER_ARCH', 'ImageOS', 'ImageVersion', 'PROOF6_APP_TOKEN', 'PROOF6_APP_INSTALLATION_ID',",
  "SOURCE_L0179": "    'PROOF6_APP_SLUG', 'PROOF6_FROZEN_MANIFEST', 'PROOF6_D04_SETUP_QUALIFICATION'}",
  "SOURCE_L0180": "",
  "SOURCE_L0181": "",
  "SOURCE_L0182": "def custody_values(helper, initial_env, argv, descriptors, setup=False):",
  "SOURCE_L0183": "    allowed = PUBLIC_ENV | SYSTEM_ENV | ({TOKEN_SLOT} if helper else (set() if setup else WRITER_ENV))",
  "SOURCE_L0184": "    require(set(initial_env) <= allowed)",
  "SOURCE_L0185": "    require(TOKEN_SLOT in initial_env if helper else TOKEN_SLOT not in initial_env)",
  "SOURCE_L0186": "    expected = [b'/usr/bin/python3', b'-I', b'-B', b'proofs/proof6/d04_signal.py', b'serve'] if helper else [",
  "SOURCE_L0187": "                b'/usr/bin/python3', b'-B', b'proofs/proof6/actions_runtime.py']",
  "SOURCE_L0188": "    if setup:",
  "SOURCE_L0189": "        expected = [b'/usr/bin/python3', b'-I', b'-B', b'proofs/proof6/d04_signal.py',",
  "SOURCE_L0190": "                    b'serve-setup' if helper else b'qualify-setup']",
  "SOURCE_L0191": "    require(argv == expected and set(descriptors) == {0, 1, 2})",
  "SOURCE_L0192": "    require(descriptors[0] == ('/dev/null', os.O_RDONLY))",
  "SOURCE_L0193": "    for fd in (1, 2):",
  "SOURCE_L0194": "        target, mode = descriptors[fd]",
  "SOURCE_L0195": "        require(mode == os.O_WRONLY)",
  "SOURCE_L0196": "        require(target == str(directory(binding()) / 'helper.log') if helper",
  "SOURCE_L0197": "                else re.fullmatch(r'pipe:\\[[0-9]+\\]', target) is not None)",
  "SOURCE_L0198": "    return {'role': 'helper' if helper else 'actual_writer', 'environment_keys': sorted(initial_env),",
  "SOURCE_L0199": "            'argv_exact': True, 'descriptors_exact': True, 'acceptance_credit': False}",
  "SOURCE_L0200": "",
  "SOURCE_L0201": "",
  "SOURCE_L0202": "def custody(helper, setup=False):",
  "SOURCE_L0203": "    import fcntl",
  "SOURCE_L0204": "    # Inspect only this process. Never read the opposite process's environment,",
  "SOURCE_L0205": "    # memory or FDs. Initial kernel environment catches pre-pop exposure too.",
  "SOURCE_L0206": "    raw = Path('/proc/self/environ').read_bytes()",
  "SOURCE_L0207": "    require(len(raw) <= 262144)",
  "SOURCE_L0208": "    initial = unique(item.split(b'=', 1) for item in raw.rstrip(b'\\0').split(b'\\0'))",
  "SOURCE_L0209": "    initial = {k.decode('ascii'): v for k, v in initial.items()}",
  "SOURCE_L0210": "    descriptors = {}",
  "SOURCE_L0211": "    for entry in Path('/proc/self/fd').iterdir():",
  "SOURCE_L0212": "        try:",
  "SOURCE_L0213": "            target = os.readlink(entry)",
  "SOURCE_L0214": "            mode = fcntl.fcntl(int(entry.name), fcntl.F_GETFL) & os.O_ACCMODE",
  "SOURCE_L0215": "        except OSError:",
  "SOURCE_L0216": "            continue  # The enumeration's own already-closed descriptor.",
  "SOURCE_L0217": "        descriptors[int(entry.name)] = (target, mode)",
  "SOURCE_L0218": "    result = custody_values(helper, initial, Path('/proc/self/cmdline').read_bytes().split(b'\\0')[:-1], descriptors, setup)",
  "SOURCE_L0219": "    receipt('CUSTODY', role=result['role'], argv_exact=True, descriptors_exact=True, acceptance_credit=False)",
  "SOURCE_L0220": "    return result",
  "SOURCE_L0221": "",
  "SOURCE_L0222": "",
  "SOURCE_L0223": "def event_valid(event, b, pid, phase, ready=None, now=None):",
  "SOURCE_L0224": "    require(type(event) is dict and set(event) == {",
  "SOURCE_L0225": "        'schema', 'binding', 'pid', 'phase', 'monotonic', 'utc', 'observation'})",
  "SOURCE_L0226": "    require(event['schema'] == SCHEMA and canonical(event['binding']) == canonical(b) and type(event['pid']) is int",
  "SOURCE_L0227": "            and event['pid'] == pid and event['phase'] == phase)",
  "SOURCE_L0228": "    stamp = event['monotonic']; now = time.monotonic() if now is None else now",
  "SOURCE_L0229": "    require(type(stamp) in (int, float) and math.isfinite(stamp) and 0 <= now - stamp <= 5)",
  "SOURCE_L0230": "    require(type(event['utc']) is str and len(event['utc']) <= 40)",
  "SOURCE_L0231": "    parsed = datetime.datetime.fromisoformat(event['utc'])",
  "SOURCE_L0232": "    require(parsed.utcoffset() == datetime.timedelta(0))",
  "SOURCE_L0233": "    record = event['observation']; capability.validate_record(record)",
  "SOURCE_L0234": "    require(record['qualified'] is True and record['context']['pid'] == pid)",
  "SOURCE_L0235": "    if phase == 'END':",
  "SOURCE_L0236": "        require(ready is not None and stamp - ready['monotonic'] >= WINDOW",
  "SOURCE_L0237": "                and record['netns_after'] == ready['observation']['netns_after'])",
  "SOURCE_L0238": "    else:",
  "SOURCE_L0239": "        require(phase == 'READY' and ready is None)",
  "SOURCE_L0240": "",
  "SOURCE_L0241": "",
  "SOURCE_L0242": "def hello_valid(value, b):",
  "SOURCE_L0243": "    require(type(value) is dict and set(value) == {",
  "SOURCE_L0244": "        'schema', 'binding', 'phase', 'pid', 'permissions', 'provider_preflight', 'deadline'})",
  "SOURCE_L0245": "    require(value['schema'] == SCHEMA and canonical(value['binding']) == canonical(b)",
  "SOURCE_L0246": "            and value['phase'] == 'QUALIFIED' and value['permissions'] == PERMISSIONS",
  "SOURCE_L0247": "            and type(value['pid']) is int and value['pid'] > 1)",
  "SOURCE_L0248": "    preflight = value['provider_preflight']",
  "SOURCE_L0249": "    require(type(preflight) is dict and set(preflight) == {",
  "SOURCE_L0250": "        'started_at', 'completed_at', 'http_status', 'date', 'request_id', 'payload'})",
  "SOURCE_L0251": "    require(type(preflight['http_status']) is int and preflight['http_status'] == 200",
  "SOURCE_L0252": "            and preflight['payload'] is None)",
  "SOURCE_L0253": "    for key in ('started_at', 'completed_at'):",
  "SOURCE_L0254": "        require(type(preflight[key]) is str and len(preflight[key]) <= 40",
  "SOURCE_L0255": "                and datetime.datetime.fromisoformat(preflight[key]).utcoffset() == datetime.timedelta(0))",
  "SOURCE_L0256": "    for key in ('date', 'request_id'):",
  "SOURCE_L0257": "        require(preflight[key] is None or (type(preflight[key]) is str and len(preflight[key]) <= 128",
  "SOURCE_L0258": "                and all(32 <= ord(c) < 127 for c in preflight[key])))",
  "SOURCE_L0259": "",
  "SOURCE_L0260": "",
  "SOURCE_L0261": "class Client:",
  "SOURCE_L0262": "    \"\"\"Writer side has no token argument, token read, API, or helper inspection.\"\"\"",
  "SOURCE_L0263": "    def __init__(self):",
  "SOURCE_L0264": "        self.binding = binding()",
  "SOURCE_L0265": "        custody(False)",
  "SOURCE_L0266": "        require(TOKEN_SLOT not in os.environ and 'GH_TOKEN' not in os.environ",
  "SOURCE_L0267": "                and 'PROOF6_D03_JOB_TOKEN' not in os.environ)",
  "SOURCE_L0268": "        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)",
  "SOURCE_L0269": "        self.socket.settimeout(8)",
  "SOURCE_L0270": "        self.socket.connect(str(directory(self.binding) / 'events.sock'))",
  "SOURCE_L0271": "        value = receive(self.socket)",
  "SOURCE_L0272": "        hello_valid(value, self.binding)",
  "SOURCE_L0273": "        helper_pid, uid, _ = peer(self.socket)",
  "SOURCE_L0274": "        require(helper_pid == value['pid'] and uid == 0 and helper_pid != os.getpid())",
  "SOURCE_L0275": "        self.deadline = value['deadline']",
  "SOURCE_L0276": "        self.qualify()",
  "SOURCE_L0277": "        self.ready = None",
  "SOURCE_L0278": "        self.ended = False",
  "SOURCE_L0279": "        receipt('WRITER_SIGNAL_READY', binding=self.binding, helper_pid=helper_pid,",
  "SOURCE_L0280": "                producer_pid=os.getpid(), acceptance_credit=False)",
  "SOURCE_L0281": "",
  "SOURCE_L0282": "    def qualify(self):",
  "SOURCE_L0283": "        require(type(self.deadline) in (int, float) and math.isfinite(self.deadline)",
  "SOURCE_L0284": "                and self.deadline - time.monotonic() >= 50)",
  "SOURCE_L0285": "        # No pre-READY writer packet: detect EOF/error/unsolicited payload",
  "SOURCE_L0286": "        # without sending a command or admitting any authority work.",
  "SOURCE_L0287": "        previous = self.socket.gettimeout()",
  "SOURCE_L0288": "        self.socket.setblocking(False)",
  "SOURCE_L0289": "        try:",
  "SOURCE_L0290": "            try:",
  "SOURCE_L0291": "                self.socket.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT)",
  "SOURCE_L0292": "            except BlockingIOError:",
  "SOURCE_L0293": "                return",
  "SOURCE_L0294": "        finally:",
  "SOURCE_L0295": "            self.socket.settimeout(previous)",
  "SOURCE_L0296": "        raise ValueError('D04_HELPER_NOT_WAITING')",
  "SOURCE_L0297": "",
  "SOURCE_L0298": "    def emit(self, item):",
  "SOURCE_L0299": "        if item['phase'] not in ('READY', 'END'):",
  "SOURCE_L0300": "            return",
  "SOURCE_L0301": "        event = dict(schema=SCHEMA, binding=self.binding, pid=os.getpid(), phase=item['phase'],",
  "SOURCE_L0302": "                     monotonic=time.monotonic(), utc=utc(), observation=item['observation'])",
  "SOURCE_L0303": "        require(not self.ended and (item['phase'] == 'READY') == (self.ready is None))",
  "SOURCE_L0304": "        event_valid(event, self.binding, os.getpid(), item['phase'], self.ready)",
  "SOURCE_L0305": "        if item['phase'] == 'END':",
  "SOURCE_L0306": "            ready_ack = receive(self.socket)",
  "SOURCE_L0307": "            require(canonical(ready_ack) == canonical({'phase': 'READY', 'binding': self.binding, 'posted': True}))",
  "SOURCE_L0308": "        packet(self.socket, event)",
  "SOURCE_L0309": "        if item['phase'] == 'READY':",
  "SOURCE_L0310": "            # Keep the existing actual 30-second timer independent of provider",
  "SOURCE_L0311": "            # latency. READY acknowledgment is checked at END, never awaited",
  "SOURCE_L0312": "            # before starting or during the actual isolation interval.",
  "SOURCE_L0313": "            self.ready = event",
  "SOURCE_L0314": "        else:",
  "SOURCE_L0315": "            ack = receive(self.socket)",
  "SOURCE_L0316": "            require(canonical(ack) == canonical({'phase': 'END', 'binding': self.binding, 'posted': True}))",
  "SOURCE_L0317": "            self.ended = True",
  "SOURCE_L0318": "",
  "SOURCE_L0319": "    def close(self):",
  "SOURCE_L0320": "        if self.socket.fileno() < 0:",
  "SOURCE_L0321": "            return",
  "SOURCE_L0322": "        try:",
  "SOURCE_L0323": "            if self.ended:",
  "SOURCE_L0324": "                self.socket.shutdown(socket.SHUT_WR)",
  "SOURCE_L0325": "                peer_shutdown(self.socket)",
  "SOURCE_L0326": "        finally:",
  "SOURCE_L0327": "            self.socket.close()",
  "SOURCE_L0328": "",
  "SOURCE_L0329": "",
  "SOURCE_L0330": "def masked_worker_record(stream):",
  "SOURCE_L0331": "    # Do not read the job payload until its actual provider build matches the",
  "SOURCE_L0332": "    # audited secret-mask-before-Trace.Info implementation. Unknown builds block.",
  "SOURCE_L0333": "    prefix = b''",
  "SOURCE_L0334": "    for _ in range(256):",
  "SOURCE_L0335": "        line = stream.readline(2049)",
  "SOURCE_L0336": "        require(line and len(line) <= 2048 and line.endswith(b'\\n'))",
  "SOURCE_L0337": "        prefix += line",
  "SOURCE_L0338": "        if re.fullmatch(rb'\\[[^\\r\\n]+ INFO Worker\\] Job message:\\r?\\n', line):",
  "SOURCE_L0339": "            text = prefix.decode('ascii')",
  "SOURCE_L0340": "            require(re.findall(r'^\\[[^\\r\\n]+ INFO Worker\\] Version: ([0-9.]+)\\r?$',text,re.M) == [RUNNER_VERSION])",
  "SOURCE_L0341": "            require(re.findall(r'^\\[[^\\r\\n]+ INFO Worker\\] Commit: ([0-9a-f]{40})\\r?$',text,re.M) == [RUNNER_COMMIT])",
  "SOURCE_L0342": "            raw = prefix + stream.read(2_000_001 - len(prefix))",
  "SOURCE_L0343": "            require(len(raw) <= 2_000_000)",
  "SOURCE_L0344": "            return raw",
  "SOURCE_L0345": "    raise ValueError('D04_AUDITED_WORKER_HEADER_UNAVAILABLE')",
  "SOURCE_L0346": "",
  "SOURCE_L0347": "",
  "SOURCE_L0348": "def _worker_log():",
  "SOURCE_L0349": "    # Only our actual Runner.Worker ancestor and its already-open diagnostic.",
  "SOURCE_L0350": "    # No caller path, environment override, retained Actions log or API token.",
  "SOURCE_L0351": "    pid = os.getppid()",
  "SOURCE_L0352": "    for _ in range(32):",
  "SOURCE_L0353": "        proc = Path('/proc') / str(pid)",
  "SOURCE_L0354": "        exe = (proc / 'exe').resolve(strict=True)",
  "SOURCE_L0355": "        if exe.name == 'Runner.Worker':",
  "SOURCE_L0356": "            expected = exe.parent.parent / '_diag'",
  "SOURCE_L0357": "            logs = []",
  "SOURCE_L0358": "            for fd in (proc / 'fd').iterdir():",
  "SOURCE_L0359": "                try:",
  "SOURCE_L0360": "                    target = fd.resolve(strict=True)",
  "SOURCE_L0361": "                except OSError:",
  "SOURCE_L0362": "                    continue",
  "SOURCE_L0363": "                if target.parent == expected and re.fullmatch(r'Worker_[A-Za-z0-9_.-]+\\.log', target.name):",
  "SOURCE_L0364": "                    logs.append(fd)",
  "SOURCE_L0365": "            require(len(logs) == 1)",
  "SOURCE_L0366": "            with logs[0].open('rb') as stream:",
  "SOURCE_L0367": "                return masked_worker_record(stream)",
  "SOURCE_L0368": "        parents = re.findall(r'^PPid:\\s+(\\d+)$', (proc / 'status').read_text(), re.M)",
  "SOURCE_L0369": "        require(len(parents) == 1 and int(parents[0]) > 1)",
  "SOURCE_L0370": "        pid = int(parents[0])",
  "SOURCE_L0371": "    raise ValueError('D03_CURRENT_WORKER_UNAVAILABLE')",
  "SOURCE_L0372": "",
  "SOURCE_L0373": "",
  "SOURCE_L0374": "def _permission_evidence(raw, binding, setup=False):",
  "SOURCE_L0375": "    # Runner initializes its secret masker BEFORE recording this startup message.",
  "SOURCE_L0376": "    # Never retain, hash, print or return the whole diagnostic/message. Only the",
  "SOURCE_L0377": "    # non-secret allowlist below enters protected evidence; no token inspection.",
  "SOURCE_L0378": "    def unique(pairs):",
  "SOURCE_L0379": "        result = {}",
  "SOURCE_L0380": "        for k, v in pairs:",
  "SOURCE_L0381": "            require(k not in result)",
  "SOURCE_L0382": "            result[k] = v",
  "SOURCE_L0383": "        return result",
  "SOURCE_L0384": "    text = raw.decode('utf-8')",
  "SOURCE_L0385": "    starts = list(re.finditer(r'^\\[[^\\r\\n]+ INFO Worker\\] Job message:\\r?\\n', text, re.M))",
  "SOURCE_L0386": "    require(len(starts) == 1)",
  "SOURCE_L0387": "    message, _ = json.JSONDecoder(object_pairs_hook=unique).raw_decode(text[starts[0].end():].lstrip())",
  "SOURCE_L0388": "    variables = message['variables']",
  "SOURCE_L0389": "    permissions = json.loads(variables['system.github.token.permissions']['value'], object_pairs_hook=unique)",
  "SOURCE_L0390": "    require(permissions == PERMISSIONS)",
  "SOURCE_L0391": "    github = message['contextData']['github']",
  "SOURCE_L0392": "    require(github['t'] == 2)",
  "SOURCE_L0393": "    context = unique((entry['k'], entry['v']) for entry in github['d'])",
  "SOURCE_L0394": "    expected = {'repository': REPO, 'repository_id': '1363510385', 'ref': RUNTIME,",
  "SOURCE_L0395": "                'workflow_ref': REPO + '/.github/workflows/proof6-writer.yml@' + RUNTIME, 'sha': binding['runtime_sha'],",
  "SOURCE_L0396": "                'run_id': str(binding['run_id']), 'run_attempt': str(binding['attempt']),",
  "SOURCE_L0397": "                'event_name': 'workflow_dispatch'}",
  "SOURCE_L0398": "    for key, value in expected.items():",
  "SOURCE_L0399": "        require(type(context[key]) is str and context[key] == value)",
  "SOURCE_L0400": "    job_name = 'signal_setup' if setup else 'd04_writer'",
  "SOURCE_L0401": "    require(variables['system.github.job']['value'] == job_name)",
  "SOURCE_L0402": "    job = message['jobId']",
  "SOURCE_L0403": "    require(type(job) is str and re.fullmatch('[0-9a-f-]{36}', job))",
  "SOURCE_L0404": "    versions = re.findall(r'^\\[[^\\r\\n]+ INFO Worker\\] Version: ([0-9.]+)\\r?$', text, re.M)",
  "SOURCE_L0405": "    commits = re.findall(r'^\\[[^\\r\\n]+ INFO Worker\\] Commit: ([0-9a-f]{40})\\r?$', text, re.M)",
  "SOURCE_L0406": "    require(versions == [RUNNER_VERSION] and commits == [RUNNER_COMMIT])",
  "SOURCE_L0407": "    return dict(source='github.token/current-worker-job-message/v1', permissions=permissions, job=job_name, worker_job_id=job,",
  "SOURCE_L0408": "                runner_version=versions[0], runner_commit=commits[0], context=expected,",
  "SOURCE_L0409": "                binding=binding)",
  "SOURCE_L0410": "",
  "SOURCE_L0411": "",
  "SOURCE_L0412": "def serve():",
  "SOURCE_L0413": "    _serve(False)",
  "SOURCE_L0414": "",
  "SOURCE_L0415": "",
  "SOURCE_L0416": "def serve_setup():",
  "SOURCE_L0417": "    _serve(True)",

  "SOURCE_L0495": "def cleanup(setup=False):",
  "SOURCE_L0496": "    b = binding(); root = directory(b)",
  "SOURCE_L0497": "    require(root.is_dir() and root.stat().st_uid == 0)",
  "SOURCE_L0498": "    # Always execute after the actual writer. A live helper now represents a",
  "SOURCE_L0499": "    # failed/incomplete sequence and must be terminated, never credited.",
  "SOURCE_L0500": "    complete = root / 'reaped.exit'",
  "SOURCE_L0501": "    settle = time.monotonic() + 2",
  "SOURCE_L0502": "    while not complete.exists() and time.monotonic() < settle:",
  "SOURCE_L0503": "        time.sleep(0.05)",
  "SOURCE_L0504": "    interrupted = not complete.exists()",
  "SOURCE_L0505": "    if interrupted:",
  "SOURCE_L0506": "        native = int((root / 'native.pid').read_text())",
  "SOURCE_L0507": "        proc = Path('/proc') / str(native)",
  "SOURCE_L0508": "        if proc.exists():",
  "SOURCE_L0509": "            require((proc / 'cmdline').read_bytes().split(b'\\0')[:-1] == [",
  "SOURCE_L0510": "                b'/usr/bin/timeout', b'--signal=KILL', b'120s', b'/usr/bin/python3',",
  "SOURCE_L0511": "                b'-I', b'-B', b'proofs/proof6/d04_signal.py', b'serve-setup' if setup else b'serve'])",
  "SOURCE_L0512": "            require(os.getpgid(native) == native)",
  "SOURCE_L0513": "            os.kill(native, signal.SIGTERM)  # timeout forwards to and reaps child.",
  "SOURCE_L0514": "    end = time.monotonic() + 8",
  "SOURCE_L0515": "    while not complete.exists() and time.monotonic() < end:",
  "SOURCE_L0516": "        time.sleep(0.1)",
  "SOURCE_L0517": "    require(complete.exists())",
  "SOURCE_L0518": "    code = int(complete.read_text())",
  "SOURCE_L0519": "    if (root / 'started.json').exists():",
  "SOURCE_L0520": "        marker = decode((root / 'started.json').read_bytes())",
  "SOURCE_L0521": "        require(marker['binding'] == b and not Path('/proc', str(marker['pid'])).exists())",
  "SOURCE_L0522": "    receipt('HELPER_REAPED', binding=b, exit_code=code, interrupted=interrupted, acceptance_credit=False)",
  "SOURCE_L0523": "    # Fixed bounded nonsecret log; no arbitrary file or credential-store read.",
  "SOURCE_L0524": "    raw = (root / 'helper.log').read_bytes()",
  "SOURCE_L0525": "    require(len(raw) <= 262144)",
  "SOURCE_L0526": "    print(raw.decode('utf-8'), end='', flush=True)",
  "SOURCE_L0527": "    require(code == 0 and not interrupted)",
  "SOURCE_L0528": "    if setup:",
  "SOURCE_L0529": "        value = decode((root / 'setup-result.json').read_bytes())",
  "SOURCE_L0530": "        value.update(helper_reaped=True, producer_reaped=True)",
  "SOURCE_L0531": "        value = setup_qualification(canonical(value))",
  "SOURCE_L0532": "        require(value['helper_pid'] == marker['pid'] and not Path('/proc', str(value['producer_pid'])).exists())",
  "SOURCE_L0533": "        print('PROOF6_SIGNAL_SETUP_OUTPUT ' + canonical(value).decode(), flush=True)",
  "SOURCE_L0534": "",
  "SOURCE_L0535": "",
  "SOURCE_L0536": "def qualify_setup():",
  "SOURCE_L0537": "    b = binding()",
  "SOURCE_L0538": "    custody(False, True)",
  "SOURCE_L0539": "    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as conn:",
  "SOURCE_L0540": "        conn.settimeout(8)",
  "SOURCE_L0541": "        conn.connect(str(directory(b) / 'events.sock'))",
  "SOURCE_L0542": "        hello = receive(conn)",
  "SOURCE_L0543": "        require(type(hello) is dict and set(hello) == {",
  "SOURCE_L0544": "            'schema', 'binding', 'phase', 'pid', 'permissions', 'provider_preflight', 'deadline'})",
  "SOURCE_L0545": "        require(hello['schema'] == SCHEMA and canonical(hello['binding']) == canonical(b) and hello['phase'] == 'SETUP_QUALIFIED'",
  "SOURCE_L0546": "                and hello['permissions'] == PERMISSIONS and hello['provider_preflight'] is None)",
  "SOURCE_L0547": "        pid, uid, _ = peer(conn)",
  "SOURCE_L0548": "        require(type(hello['pid']) is int and hello['pid'] == pid and uid == 0 and pid != os.getpid())",
  "SOURCE_L0549": "        require(type(hello['deadline']) in (int, float) and math.isfinite(hello['deadline'])",
  "SOURCE_L0550": "                and hello['deadline'] - time.monotonic() >= 50)",
  "SOURCE_L0551": "        packet(conn, {'schema': SCHEMA, 'binding': b, 'phase': 'SETUP_FINISH', 'pid': os.getpid()})",
  "SOURCE_L0552": "        require(canonical(receive(conn)) == canonical({'schema': SCHEMA, 'binding': b, 'phase': 'SETUP_FINISHED'}))",
  "SOURCE_L0553": "        conn.shutdown(socket.SHUT_WR)",
  "SOURCE_L0554": "        peer_shutdown(conn)",
  "SOURCE_L0555": "    receipt('SETUP_PEER_COMPLETED', binding=b, producer_pid=os.getpid(), acceptance_credit=False)",
  "SOURCE_L0556": "",
  "SOURCE_L0557": "",
  "SOURCE_L0558": "def setup_qualification(raw):",
  "SOURCE_L0559": "    if isinstance(raw, str):",
  "SOURCE_L0560": "        raw = raw.encode('ascii')",
  "SOURCE_L0561": "    value = decode(raw)",
  "SOURCE_L0562": "    expected = {'schema': SCHEMA, 'binding': binding(), 'phase': 'SETUP_SIGNAL_QUALIFIED',",
  "SOURCE_L0563": "        'permissions': PERMISSIONS, 'runner_version': RUNNER_VERSION, 'runner_commit': RUNNER_COMMIT,",
  "SOURCE_L0564": "        'custody': True, 'status_posts': 0, 'acceptance_credit': False,",
  "SOURCE_L0565": "        'helper_reaped': True, 'producer_reaped': True}",
  "SOURCE_L0566": "    require(type(value) is dict and set(value) == set(expected) | {'helper_pid', 'producer_pid'})",
  "SOURCE_L0567": "    require(canonical({k:value[k] for k in expected}) == canonical(expected))",
  "SOURCE_L0568": "    require(all(type(value[k]) is int and value[k] > 1 for k in ('helper_pid', 'producer_pid'))",
  "SOURCE_L0569": "            and value['helper_pid'] != value['producer_pid'])",
  "SOURCE_L0570": "    return value",
  "SOURCE_L0571": "",
  "SOURCE_L0572": "",
  "SOURCE_L0573": "if __name__ == '__main__':",
  "SOURCE_L0574": "    import d04_startup_diagnostic as diagnostic",
  "SOURCE_L0575": "    diagnostic.install(__file__)",
  "SOURCE_L0576": "    try:",
  "SOURCE_L0577": "        require(len(sys.argv) == 2 and sys.argv[1] in (",
  "SOURCE_L0578": "            'serve-setup', 'qualify-setup', 'cleanup-setup'))",
  "SOURCE_L0579": "        {'serve': serve, 'cleanup': cleanup, 'serve-setup': serve_setup,",
  "SOURCE_L0580": "         'qualify-setup': qualify_setup, 'cleanup-setup': lambda: cleanup(True)}[sys.argv[1]]()",
  "SOURCE_L0581": "    except BaseException as error:",
  "SOURCE_L0582": "        diagnostic.blocked(error)",
  "SOURCE_L0583": "        receipt('BLOCKED', exception=type(error).__name__, acceptance_credit=False)",
  "SOURCE_L0584": "        sys.exit(1)"
}
